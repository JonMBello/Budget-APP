# Server only. Never prefix these variables with NEXT_PUBLIC_.
BUDGET_APP_API_URL=http://127.0.0.1:3000/api
BUDGET_APP_API_KEY=
# Match the URL you open. `npm run dev`, `npm start`, and e2e all use 3003.
BUDGET_APP_ORIGIN=http://127.0.0.1:3003
BUDGET_APP_ALLOW_REGISTRATION=false
# Persistent private directory for the single-instance VPS session store.
BUDGET_APP_SESSION_DIR=.data/sessions
