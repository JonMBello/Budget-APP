# Confirm both upstream ports before installing on the VPS.
budget.jonmb.com {
    encode zstd gzip
    @api path /api /api/*
    handle @api {
        reverse_proxy 127.0.0.1:3000
    }
    @app path /app /app/*
    handle @app {
        reverse_proxy 127.0.0.1:3003
    }
    @root_icons path /apple-touch-icon.png /apple-touch-icon-precomposed.png /apple-icon.png /favicon.ico
    handle @root_icons {
        rewrite * /app{path}
        reverse_proxy 127.0.0.1:3003
    }
    handle / {
        redir /app 302
    }
    handle {
        respond "Not found" 404
    }
}
